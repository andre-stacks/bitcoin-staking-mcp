{
  "name": "bitcoin-staking-mcp",
  "version": "0.5.0",
  "description": "A read-only, source-aware MCP server for Bitcoin Staking on Stacks.",
  "type": "module",
  "license": "MIT",
  "author": "Andre Serrano",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "bitcoin-staking-mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "packages/registry-contract",
    ".agents/skills/bitcoin-staking-concierge",
    "docs/INSTALLATION.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.js",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsx src/stdio.ts",
    "start": "node dist/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "BITCOIN_STAKING_DISABLE_REMOTE_REGISTRY=1 tsx --test tests/*.test.ts",
    "test:live": "BITCOIN_STAKING_LIVE_TEST=1 tsx --test tests/live.test.ts",
    "registry:validate": "BITCOIN_STAKING_DISABLE_REMOTE_REGISTRY=1 tsx scripts/check-registry.ts",
    "registry:build": "tsx scripts/build-registry-snapshot.ts",
    "registry:validate:live": "BITCOIN_STAKING_DISABLE_REMOTE_REGISTRY=1 tsx scripts/check-registry.ts --live",
    "check:console": "npm run typecheck --workspace @bitcoin-staking/registry-console && npm test --workspace @bitcoin-staking/registry-console && npm run build --workspace @bitcoin-staking/registry-console",
    "check": "npm run typecheck && npm run registry:validate && npm run build && npm test && npm run check:console",
    "setup": "node dist/cli.js setup --local",
    "update": "node dist/cli.js update --local",
    "setup:check": "node dist/cli.js check --local",
    "uninstall": "node dist/cli.js uninstall"
  },
  "keywords": [
    "bitcoin",
    "stacks",
    "staking",
    "mcp",
    "agents"
  ],
  "dependencies": {
    "@bitcoin-staking/registry-contract": "file:packages/registry-contract",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@stacks/bitcoin-staking": "7.6.0",
    "@stacks/network": "7.6.0",
    "@stacks/transactions": "7.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.9",
    "typescript": "5.9.3"
  }
}
